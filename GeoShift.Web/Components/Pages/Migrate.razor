@page "/migrate"
@rendermode InteractiveServer
@using GeoShift.Core.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Migration Workspace — GeoShift</PageTitle>
<div class="gs-container gs-workspace">
    <div class="gs-page-kicker">DATA MIGRATION WORKSPACE</div>
    <h1 class="gs-page-title">Merge and review your data.</h1>
    <p class="gs-page-description">Upload up to three CSV files, map equivalent identifier columns, and preview duplicates. This workspace never automatically removes records.</p>

    <section class="gs-panel">
        <div class="gs-panel-heading"><h2>Import CSV files</h2><span class="gs-step">STEP 01</span></div>
        <InputFile OnChange="LoadFiles" multiple accept=".csv,text/csv" disabled="@_busy" />
        <p class="gs-note">Up to 3 CSV files, 2 MB per file, 5,000 data rows per file. Files are processed in memory for this preview.</p>
        @foreach (var dataset in _datasets)
        {
            <div class="gs-file-info"><strong>@dataset.Name</strong><span> · @dataset.Rows.Count rows</span></div>
        }
    </section>

    @if (_datasets.Count > 0)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Match identifier columns</h2><span class="gs-step">STEP 02</span></div>
            <p class="gs-note">Choose the column representing the same identifier in each file. For example, Site # and Location ID.</p>
            @foreach (var dataset in _datasets)
            {
                <div class="mb-3">
                    <label class="form-label">@dataset.Name</label>
                    <select class="form-select" value="@dataset.KeyColumn" @onchange="e => SetKey(dataset, e.Value?.ToString())">
                        @foreach (var column in dataset.Columns)
                        {
                            <option value="@column">@column</option>
                        }
                    </select>
                </div>
            }
            <button class="btn btn-primary" @onclick="RunPreview" disabled="@_busy">Preview migration →</button>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_result is not null)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Migration report</h2><span class="gs-step">STEP 03</span></div>
            <div class="gs-stats">
                <div class="gs-stat"><div class="gs-stat-label">Imported</div><div class="gs-stat-value">@_result.Report.ImportedRows</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Duplicate groups</div><div class="gs-stat-value">@_result.Report.DuplicateGroups</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Conflicting groups</div><div class="gs-stat-value">@_result.Report.GroupsWithConflicts</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Missing keys</div><div class="gs-stat-value">@_result.Report.RowsMissingMatchKeys</div></div>
            </div>
            <p class="gs-note">No records are consolidated until you confirm them in the review below.</p>
            <div class="gs-preview-table">
                <table class="table table-hover">
                    <thead><tr><th>Identifier</th><th>Records</th><th>Conflicting columns</th></tr></thead>
                    <tbody>
                        @foreach (var group in _result.Duplicates.Groups.Take(20))
                        {
                            <tr>
                                <td>@string.Join(", ", group.Key.Values)</td>
                                <td>@group.RowIndices.Count</td>
                                <td>@(group.HasConflicts ? string.Join(", ", group.ConflictingColumns) : "None")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Fix duplicate information</h2><span class="gs-step">STEP 04</span></div>
            @if (_result.Duplicates.Groups.Count == 0)
            {
                <p>No duplicate identifiers were found. Nothing needs reviewing.</p>
            }
            else
            {
                var groups = _result.Duplicates.Groups;
                var group = groups[_reviewIndex];
                var id = group.RowIndices[0];
                var draft = _drafts[id];
                var questionIndex = Math.Min(_questionIndex, Math.Max(0, group.ConflictingColumns.Count - 1));
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="gs-page-kicker">DUPLICATE @(_reviewIndex + 1) OF @groups.Count</div>
                        <h3 class="mb-1">Site / ID: @string.Join(", ", group.Key.Values)</h3>
                    </div>
                    <span class="gs-note">@(_decisions.ContainsKey(id) ? "Confirmed" : _skipped.Contains(id) ? "Keeping separate" : "Needs review")</span>
                </div>
                <div class="progress mb-3" role="progressbar" aria-label="Duplicate review progress" aria-valuenow="@(_reviewIndex + 1)" aria-valuemin="0" aria-valuemax="@groups.Count">
                    <div class="progress-bar" style="@($"width:{100.0 * (_reviewIndex + 1) / groups.Count:F1}%")"></div>
                </div>
                @if (group.HasConflicts)
                {
                    var column = group.ConflictingColumns[questionIndex];
                    <div class="border rounded p-3 mb-3">
                        <div class="gs-page-kicker">QUESTION @(questionIndex + 1) OF @group.ConflictingColumns.Count</div>
                        <h4 class="mt-2">Which @column value is correct?</h4>
                        <p class="gs-note">These uploaded files disagree. Select the correct value. If you aren't sure, keep the records separate.</p>
                        @foreach (var index in group.RowIndices)
                        {
                            var row = _result.Merged.Rows[index];
                            var value = row.Columns.TryGetValue(column, out var cell) ? cell : null;
                            <label class="d-block border rounded p-3 mb-2" style="cursor:pointer">
                                <input type="radio" name="@($"choice-{id}-{column}")" checked="@(draft.Sources.TryGetValue(column, out var chosen) && chosen == index)" @onchange="() => ChooseAnswer(id, column, index)" />
                                <strong class="ms-2">@(string.IsNullOrWhiteSpace(value) ? "(No value)" : value)</strong>
                                <div class="gs-note ms-4">From @row.SourceDataset · row @row.SourceRowNumber</div>
                            </label>
                        }
                        <div class="d-flex justify-content-between mt-3 gap-2">
                            <button class="btn btn-outline-secondary" disabled="@(questionIndex == 0)" @onclick="PreviousQuestion">← Previous question</button>
                            <button class="btn btn-primary" disabled="@(!draft.Sources.ContainsKey(column))" @onclick="NextQuestion">
                                @(questionIndex == group.ConflictingColumns.Count - 1 ? "Review my choices →" : "Next question →")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">These records have matching values. You can keep one copy or leave both unchanged.</div>
                }

                @if (!group.HasConflicts || _showSummary)
                {
                    <div class="border rounded p-3 mb-3">
                        <h4>Here's what your cleaned record will contain</h4>
                        <p class="gs-note">GeoShift will retain one record for this identifier only if you confirm. Values not in conflict are taken from the first uploaded record; missing fields are not filled automatically.</p>
                        <div class="gs-preview-table">
                            <table class="table table-hover">
                                <tbody>
                                    @foreach (var column in _result.Merged.Columns)
                                    {
                                        var sourceIndex = GetSource(id, column);
                                        var row = _result.Merged.Rows[sourceIndex];
                                        <tr><th scope="row">@column</th><td>@(row.Columns.TryGetValue(column, out var cell) ? cell : "")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button class="btn btn-primary" disabled="@(group.ConflictingColumns.Any(column => !draft.Sources.ContainsKey(column)))" @onclick="() => Approve(id)">Confirm — keep one cleaned record</button>
                        @if (_decisions.ContainsKey(id))
                        {
                            <button class="btn btn-outline-secondary ms-2" @onclick="() => Undo(id)">Undo confirmation</button>
                        }
                    </div>
                }
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-outline-secondary" @onclick="() => Skip(id)">I'm not sure — keep all records</button>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <button class="btn btn-outline-secondary" disabled="@(_reviewIndex == 0)" @onclick="PreviousGroup">← Previous duplicate</button>
                    <button class="btn btn-outline-primary" disabled="@(_reviewIndex == groups.Count - 1)" @onclick="NextGroup">Next duplicate →</button>
                </div>
                <p class="gs-note mt-3">@_decisions.Count confirmed · @_skipped.Count kept separate · @(groups.Count - _decisions.Count - _skipped.Count) awaiting review · @_result.Report.OutputRows output records</p>
                <button class="btn btn-outline-secondary" disabled="@(_decisions.Count == 0 && _skipped.Count == 0)" @onclick="ResetDecisions">Reset all choices</button>
            }
        </section>
    }
</div>

@code {
    private sealed class UploadedDataset
    {
        public required string Name { get; init; }
        public required IReadOnlyList<IReadOnlyDictionary<string, string?>> Rows { get; init; }
        public required IReadOnlyList<string> Columns { get; init; }
        public required string KeyColumn { get; set; }
    }

    private readonly List<UploadedDataset> _datasets = [];
    private MigrationWorkflowResult? _result;
    private string? _error;
    private bool _busy;
    private int _reviewIndex;
    private int _questionIndex;
    private bool _showSummary;
    private readonly HashSet<int> _skipped = [];

    private sealed class DraftDecision
    {
        public int KeepRow { get; set; }
        public Dictionary<string, int> Sources { get; } = new(StringComparer.OrdinalIgnoreCase);
    }
    private readonly Dictionary<int, DraftDecision> _drafts = [];
    private readonly Dictionary<int, ConflictResolutionDecision> _decisions = [];

    private int GetSource(int id, string column) =>
        _drafts[id].Sources.TryGetValue(column, out var index) ? index : _drafts[id].KeepRow;

    private void ChooseAnswer(int id, string column, int index)
    {
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (!group.RowIndices.Contains(index) || !group.ConflictingColumns.Contains(column)) return;
        _drafts[id].Sources[column] = index;
        _decisions.Remove(id);
        _skipped.Remove(id);
        _showSummary = false;
        RefreshResolution();
    }

    private void PreviousQuestion()
    {
        if (_questionIndex > 0) { _questionIndex--; _showSummary = false; }
    }

    private void NextQuestion()
    {
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (_questionIndex < group.ConflictingColumns.Count - 1)
            _questionIndex++;
        else if (group.ConflictingColumns.All(column => _drafts[group.RowIndices[0]].Sources.ContainsKey(column)))
            _showSummary = true;
    }

    private void Approve(int id)
    {
        var draft = _drafts[id];
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (group.ConflictingColumns.Any(column => !draft.Sources.ContainsKey(column))) return;
        _decisions[id] = new ConflictResolutionDecision(draft.KeepRow,
            new Dictionary<string, int>(draft.Sources, StringComparer.OrdinalIgnoreCase));
        _skipped.Remove(id);
        RefreshResolution();
        NextGroup();
    }

    private void Undo(int id) { _decisions.Remove(id); RefreshResolution(); }
    private void Skip(int id)
    {
        _decisions.Remove(id);
        _skipped.Add(id);
        RefreshResolution();
        NextGroup();
    }
    private void PreviousGroup() { if (_reviewIndex > 0) { _reviewIndex--; _questionIndex = 0; _showSummary = false; } }
    private void NextGroup()
    {
        if (_result is not null && _reviewIndex + 1 < _result.Duplicates.Groups.Count) { _reviewIndex++; _questionIndex = 0; _showSummary = false; }
    }
    private void ResetDecisions()
    {
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        RefreshResolution();
    }

    private void RefreshResolution()
    {
        if (_result is null) return;
        try
        {
            var resolved = new ConflictResolutionEngine().Resolve(
                _result.Merged, _result.Duplicates, _decisions.Values.ToArray());
            var report = new MigrationReportEngine().Build(_result.Merged, _result.Duplicates, resolved);
            _result = _result with { Resolved = resolved, Report = report };
            _error = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidDataException)
        {
            _error = ex.Message;
        }
    }


    private async Task LoadFiles(InputFileChangeEventArgs args)
    {
        _busy = true;
        _error = null;
        _result = null;
        _datasets.Clear();
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        try
        {
            var files = args.GetMultipleFiles(3);
            foreach (var file in files)
            {
                if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
                    throw new InvalidDataException("Only CSV files are supported.");
                await using var stream = file.OpenReadStream(2 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                using var reader = new StreamReader(buffer);
                var rows = MigrationCsvReader.Read(reader);
                var columns = rows.Count > 0 ? rows[0].Keys.ToArray() : Array.Empty<string>();
                if (columns.Length == 0)
                    throw new InvalidDataException($"'{file.Name}' has no data rows.");
                _datasets.Add(new UploadedDataset
                {
                    Name = file.Name,
                    Rows = rows,
                    Columns = columns,
                    KeyColumn = columns[0]
                });
            }
            if (_datasets.Select(x => x.Name).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _datasets.Count)
                throw new InvalidDataException("Files must have distinct names.");
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException)
        {
            _datasets.Clear();
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private void SetKey(UploadedDataset dataset, string? column)
    {
        if (column is not null && dataset.Columns.Contains(column)) dataset.KeyColumn = column;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
    }

    private void RunPreview()
    {
        _error = null;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        try
        {
            var inputs = _datasets.Select(d => new MigrationWorkflowDataset(
                d.Name, d.Rows, new[] { new ColumnMappingRule(d.KeyColumn, "GeoShift Match Key") })).ToArray();
            _result = new MigrationWorkflowEngine().Execute(
                new MigrationWorkflowRequest(inputs, ["GeoShift Match Key"], []));
            foreach (var group in _result.Duplicates.Groups)
                _drafts.Add(group.RowIndices[0], new DraftDecision { KeepRow = group.RowIndices[0] });
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException)
        {
            _error = ex.Message;
        }
    }
}
