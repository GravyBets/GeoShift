@page "/migrate"
@rendermode InteractiveServer
@using GeoShift.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>Migration Workspace — GeoShift</PageTitle>
<div class="gs-container gs-workspace">
    <div class="gs-page-kicker">DATA MIGRATION WORKSPACE</div>
    <h1 class="gs-page-title">Merge and review your data.</h1>
    <p class="gs-page-description">Import files, match columns, review duplicates, and export clean data. You decide which records to combine.</p>
    <div class="gs-checkpoint-bar">
        <button class="btn btn-outline-primary btn-sm" @onclick="RestoreCheckpoint" disabled="@(_result is null)">Restore saved decisions</button>
        @if (_result is not null)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="SaveCheckpoint">Save review progress</button>
        }
        <button class="btn btn-link btn-sm" @onclick="ClearCheckpoint">Clear saved review</button>
        @if (_checkpointNeedsRestore)
        {
            @if (!_checkpointOverwriteConfirmed)
            {
                <button class="btn btn-outline-warning btn-sm" @onclick="() => _checkpointOverwriteConfirmed = true">Start a new review instead</button>
            }
            else
            {
                <span class="gs-note">Replace the previous saved checkpoint?</span>
                <button class="btn btn-warning btn-sm" @onclick="StartFreshCheckpoint">Confirm new review</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _checkpointOverwriteConfirmed = false">Cancel</button>
            }
        }
        <span class="gs-note" role="status">@_checkpointMessage</span>
    </div>
    <nav class="gs-workflow-nav" aria-label="Migration workflow">
        <a href="#gs-import">1. Import</a>
        <a href="#gs-match">2. Match</a>
        <a href="#gs-report">3. Review</a>
        <a href="#gs-export">4. Export</a>
    </nav>

    <section class="gs-panel" id="gs-import">
        <div class="gs-panel-heading"><h2>Import CSV or Excel files</h2><span class="gs-step">STEP 01</span></div>
        <div class="gs-dropzone" id="gs-migration-dropzone" role="button" tabindex="0" aria-label="Choose or drop up to three CSV or Excel files">
            <div class="gs-upload-icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3m0 0L7 8m5-5 5 5"/><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-3"/></svg></div>
            <strong>Drag &amp; drop CSV or Excel files here</strong>
            <p>Drop up to three files into this area, or select them from your computer</p>
            <span class="gs-browse-btn" aria-hidden="true">Browse files <span>↗</span></span>
            <small class="gs-upload-hint">CSV or XLSX · Up to 3 files · 2 MB each</small>
            <InputFile @key="_fileInputKey" OnChange="LoadFiles" multiple accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@_busy" class="gs-hidden-file-input" aria-label="Select CSV or Excel files" />
        </div>
        <p class="gs-note mt-3">Up to 5,000 data rows per file. Excel uses the first worksheet; formula cells are not supported. Files are processed in memory for this preview.</p>
        @foreach (var dataset in _datasets)
        {
            <div class="gs-file-info"><strong>@dataset.Name</strong><span> · @dataset.Rows.Count rows</span></div>
        }
    </section>

    @if (_datasets.Count > 0)
    {
        <section class="gs-panel" id="gs-match">
            <div class="gs-panel-heading"><h2>Match identifier columns</h2><span class="gs-step">STEP 02</span></div>
            <p class="gs-note">Choose the column representing the same identifier in each file. For example, Site # and Location ID.</p>
            @foreach (var dataset in _datasets)
            {
                <div class="mb-3">
                    <label class="form-label">@dataset.Name</label>
                    <select class="form-select" value="@dataset.KeyColumn" @onchange="e => SetKey(dataset, e.Value?.ToString())">
                        @foreach (var column in dataset.Columns)
                        {
                            <option value="@column">@column</option>
                        }
                    </select>
                </div>
            }
            <div class="border rounded p-3 mb-3">
                <h4>Saved mapping templates</h4>
                <p class="gs-note">Reuse mappings for the same file layouts. Templates are stored in this browser, not on the server.</p>
                <button class="btn btn-outline-secondary mb-2" @onclick="LoadTemplates">Load saved templates</button>
                @if (_templates.Count > 0)
                {
                    <select class="form-select mb-2" @bind="_selectedTemplate">
                        <option value="">Choose a template</option>
                        @foreach (var template in _templates)
                        {
                            <option value="@template.Name">@template.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-primary me-2" disabled="@string.IsNullOrWhiteSpace(_selectedTemplate)" @onclick="ApplyTemplate">Apply template</button>
                    <button class="btn btn-outline-danger" disabled="@string.IsNullOrWhiteSpace(_selectedTemplate)" @onclick="DeleteTemplate">Delete template</button>
                }
                <div class="mt-3">
                    <label class="form-label">Save current mappings as</label>
                    <input class="form-control mb-2" @bind="_newTemplateName" maxlength="80" placeholder="e.g. Weekly radio inventory" />
                    <button class="btn btn-outline-primary" disabled="@string.IsNullOrWhiteSpace(_newTemplateName)" @onclick="SaveTemplate">Save mapping template</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_templateMessage))
                {
                    <p class="gs-note mt-2">@_templateMessage</p>
                }
            </div>
            <details class="border rounded p-3 mb-3">
                <summary><strong>Match other column names (optional)</strong></summary>
                <p class="gs-note mt-2">Give equivalent fields the same output name. GeoShift can suggest likely matches, but nothing changes without your approval.</p>
                @if (PendingNameSuggestions.Count > 0)
                {
                    <div class="border rounded p-3 mb-3">
                        <strong>Suggested column matches</strong>
                        @foreach (var suggestion in PendingNameSuggestions)
                        {
                            <div class="gs-note mt-2">
                                @_datasets[suggestion.DatasetIndex].Name:
                                <strong>@suggestion.SourceColumn</strong> → <strong>@suggestion.SuggestedOutputColumn</strong>
                            </div>
                        }
                        @if (!_confirmMappings)
                        {
                            <button class="btn btn-outline-primary mt-3" @onclick="() => _confirmMappings = true">Review suggested changes</button>
                        }
                        else
                        {
                            <p class="gs-note mt-3">Apply these names to the output? You can still edit them before previewing.</p>
                            <button class="btn btn-primary me-2" @onclick="ApplyNameSuggestions">Apply suggestions</button>
                            <button class="btn btn-outline-secondary" @onclick="() => _confirmMappings = false">Cancel</button>
                        }
                    </div>
                }
                @foreach (var dataset in _datasets)
                {
                    <h4 class="mt-3">@dataset.Name</h4>
                    @foreach (var column in dataset.Columns.Where(column => column != dataset.KeyColumn))
                    {
                        <div class="row align-items-center mb-2">
                            <label class="col-sm-5 col-form-label">@column</label>
                            <div class="col-sm-7">
                                <input class="form-control" aria-label="@($"Output name for {column} in {dataset.Name}")"
                                       value="@dataset.OutputNames[column]"
                                       @onchange="e => SetOutputName(dataset, column, e.Value?.ToString())" />
                            </div>
                        </div>
                    }
                }
            </details>
            <button class="btn btn-primary" @onclick="PreviewAndCheckCheckpoint" disabled="@_busy">Preview migration →</button>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_result is not null)
    {
        <section class="gs-panel" id="gs-report">
            <div class="gs-panel-heading"><h2>Migration report</h2><span class="gs-step">STEP 03</span></div>
            <div class="gs-review-dashboard">
                <div><strong>@_decisions.Count</strong><span>Combined</span></div>
                <div><strong>@_skipped.Count</strong><span>Kept separate</span></div>
                <div><strong>@UnreviewedCount</strong><span>Need a decision</span></div>
                <div><strong>@_result.Report.OutputRows</strong><span>Output records</span></div>
            </div>
            <div class="gs-stats">
                <div class="gs-stat"><div class="gs-stat-label">Imported</div><div class="gs-stat-value">@_result.Report.ImportedRows</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Duplicate groups</div><div class="gs-stat-value">@_result.Report.DuplicateGroups</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Identical</div><div class="gs-stat-value">@CountKind(DuplicateGroupKind.Identical)</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Missing information</div><div class="gs-stat-value">@CountKind(DuplicateGroupKind.Complementary)</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Disagreements</div><div class="gs-stat-value">@CountKind(DuplicateGroupKind.Conflicting)</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Missing keys</div><div class="gs-stat-value">@_result.Report.RowsMissingMatchKeys</div></div>
            </div>
            <p class="gs-note">No records are consolidated without your approval.</p>
            @if (ExactPendingCount > 0)
            {
                <div class="border rounded p-3 mb-3">
                    <strong>@ExactPendingCount identical duplicate groups</strong>
                    <p class="gs-note">All fields match. Approve these together instead of reviewing each one.</p>
                    @if (!_confirmExact)
                    {
                        <button class="btn btn-outline-primary" @onclick="() => _confirmExact = true">Review exact matches</button>
                    }
                    else
                    {
                        <p>Combine @ExactPendingCount groups into one record each? Original uploads remain unchanged.</p>
                        <button class="btn btn-primary me-2" @onclick="ApproveExactMatches">Confirm exact matches</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _confirmExact = false">Cancel</button>
                    }
                </div>
            }
            @if (RecoverablePendingCount > 0)
            {
                <div class="border rounded p-3 mb-3">
                    <strong>@RecoverablePendingCount groups with recoverable missing information</strong>
                    <p class="gs-note">Each proposed value is the only non-empty value for that field across its matching records. Genuine disagreements are excluded.</p>
                    @if (!_confirmRecoverable)
                    {
                        <button class="btn btn-outline-primary" @onclick="() => _confirmRecoverable = true">Review recoverable values</button>
                    }
                    else
                    {
                        <p><strong>Preview:</strong> @RecoverablePendingCount groups will be combined. The values below will fill empty cells; original files remain unchanged.</p>
                        <div class="gs-preview-table mb-3" style="max-height:280px;overflow:auto">
                            <table class="table table-sm">
                                <thead><tr><th>Identifier</th><th>Field</th><th>Recovered value</th><th>Source</th></tr></thead>
                                <tbody>
                                    @foreach (var proposal in RecoverableProposals)
                                    {
                                        @foreach (var fill in proposal.Fills)
                                        {
                                            var sourceRow = _result.Merged.Rows[fill.Value];
                                            <tr><td>@string.Join(", ", proposal.Group.Key.Values)</td><td>@fill.Key</td><td>@sourceRow.Columns[fill.Key]</td><td>@sourceRow.SourceDataset · row @sourceRow.SourceRowNumber</td></tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="gs-note">All @RecoverablePendingCount groups are listed above. Confirm only if the proposed values are correct.</p>
                        <button class="btn btn-primary me-2" @onclick="ApproveRecoverable">Approve recoverable groups</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _confirmRecoverable = false">Cancel</button>
                    }
                </div>
            }
            @if (UnreviewedCount > 0)
            {
                <div class="border rounded p-3 mb-3">
                    <strong>@UnreviewedCount groups still need a decision</strong>
                    <p class="gs-note">Keep all remaining groups separate without answering each question. Existing approved merges are preserved.</p>
                    @if (!_confirmKeepRemaining)
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => _confirmKeepRemaining = true">Review keep-all-remaining option</button>
                    }
                    else
                    {
                        <p>Confirm: @UnreviewedCount groups will remain as separate records. Previously approved merges won't change.</p>
                        <button class="btn btn-primary me-2" @onclick="KeepRemainingSeparate">Keep remaining groups separate</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _confirmKeepRemaining = false">Cancel</button>
                    }
                </div>
            }
            <details class="gs-secondary-details">
                <summary>View sample duplicate groups (first 20)</summary>
                <div class="gs-preview-table mt-3">
                <table class="table table-hover">
                    <thead><tr><th>Identifier</th><th>Records</th><th>Review type</th><th>Fields to review</th></tr></thead>
                    <tbody>
                        @foreach (var group in _result.Duplicates.Groups.Take(20))
                        {
                            <tr>
                                <td>@string.Join(", ", group.Key.Values)</td>
                                <td>@group.RowIndices.Count</td>
                                <td>@DescribeKind(group)</td>
                                <td>@(group.HasConflicts ? string.Join(", ", group.ConflictingColumns) : "None")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </details>
        </section>

        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Validate data</h2><span class="gs-step">QUALITY CHECK</span></div>
            <p class="gs-note">Choose which fields must have values. GeoShift checks the current cleaned preview, including any confirmed duplicate decisions. Nothing is edited automatically.</p>
            <div class="mb-3">
                @foreach (var column in _result.Merged.Columns)
                {
                    <label class="d-inline-block me-3 mb-2">
                        <input type="checkbox" checked="@_requiredColumns.Contains(column)"
                               @onchange="e => SetRequiredColumn(column, e.Value is true)" />
                        @column
                    </label>
                }
            </div>
            <p><strong>@CurrentValidation.ErrorCount missing required values</strong> · <strong>@CurrentValidation.WarningCount formatting warnings</strong></p>
            @if (CurrentValidation.Issues.Count == 0)
            {
                <p class="gs-note">No issues found under the selected checks.</p>
            }
            else
            {
                <div class="gs-preview-table">
                    <table class="table table-hover">
                        <thead><tr><th>Severity</th><th>Source</th><th>Row</th><th>Column</th><th>Finding</th></tr></thead>
                        <tbody>
                            @foreach (var issue in CurrentValidation.Issues.Take(50))
                            {
                                <tr>
                                    <td>@issue.Severity</td>
                                    <td>@issue.SourceDataset</td>
                                    <td>@issue.SourceRowNumber</td>
                                    <td>@issue.Column</td>
                                    <td>@issue.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (CurrentValidation.Issues.Count > 50)
                {
                    <p class="gs-note">Showing the first 50 of @CurrentValidation.Issues.Count findings.</p>
                }
            }
        </section>

        @if (ReviewComplete || _result.Duplicates.Groups.Count == 0)
        {
            <section class="gs-panel">
                <div class="gs-panel-heading"><h2>Correct flagged values</h2><span class="gs-step">QUALITY CHECK</span></div>
                <p class="gs-note">Corrections change only the exported preview. Each edit requires confirmation and is recorded in the correction audit.</p>
                <p><strong>@_corrections.Count approved corrections</strong> · <strong>@CurrentValidation.Issues.Count remaining findings</strong></p>
                @if (_editingIssue is not null)
                {
                    var issue = _editingIssue;
                    var row = CorrectedRows.Rows.First(r => r.OriginalRowIndex == issue.OriginalRowIndex);
                    row.Columns.TryGetValue(issue.Column, out var before);
                    <p><strong>@issue.SourceDataset · row @issue.SourceRowNumber · @issue.Column</strong></p>
                    <p>Current: <code>@(before ?? "(empty)")</code></p>
                    <label class="form-label">Replacement value</label>
                    <input class="form-control mb-2" @bind="_replacementValue" />
                    <p>Preview: <code>@_replacementValue</code></p>
                    <button class="btn btn-primary me-2" @onclick="ConfirmCorrection">Confirm correction</button>
                    <button class="btn btn-outline-secondary" @onclick="CancelCorrection">Cancel</button>
                }
                else if (CurrentValidation.Issues.Count > 0)
                {
                    var issue = CurrentValidation.Issues[0];
                    <p><strong>@issue.SourceDataset · row @issue.SourceRowNumber · @issue.Column</strong></p>
                    <p>@issue.Message</p>
                    <button class="btn btn-primary" @onclick="() => StartCorrection(issue)">Correct this value</button>
                    <p class="gs-note mt-2">You can leave a finding unresolved and still export; the validation report will show it.</p>
                }
                else
                {
                    <p>No remaining validation findings.</p>
                }
            </section>
        }

        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Clean up duplicates</h2><span class="gs-step">STEP 04</span></div>
            @if (_checkpointNeedsRestore)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Review recovery available.</strong> Previous decisions are protected from automatic overwrite.
                    Restore saved decisions above, or confirm that you want to start a new review.
                </div>
            }
            @if (_result.Duplicates.Groups.Count > 0)
            {
                <div class="gs-review-filters" aria-label="Filter duplicate groups">
                    @foreach (var option in new[] {
                        ("all", "All", _result.Duplicates.Groups.Count),
                        ("undecided", "Undecided", UnreviewedCount),
                        ("identical", "Identical", CountKind(DuplicateGroupKind.Identical)),
                        ("complementary", "Missing info", CountKind(DuplicateGroupKind.Complementary)),
                        ("conflicting", "Disagreements", CountKind(DuplicateGroupKind.Conflicting)),
                        ("combined", "Combined", _decisions.Count),
                        ("separate", "Kept separate", _skipped.Count) })
                    {
                        <button type="button" class="btn btn-sm @(_reviewFilter == option.Item1 ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => SetReviewFilter(option.Item1)">@option.Item2 (@option.Item3)</button>
                    }
                </div>
            }
            @if (_checkpointNeedsRestore)
            {
                <p class="gs-note">Review actions are paused until you restore your saved review or confirm a fresh start.</p>
            }
            else if (_result.Duplicates.Groups.Count == 0)
            {
                <p>No duplicate records found.</p>
            }
            else if (ReviewComplete)
            {
                <h3>No duplicate decisions remaining</h3>
                <p>All @_result.Duplicates.Groups.Count groups have been either combined or kept separate.</p>
                <p><strong>@_decisions.Count</strong> combined · <strong>@_skipped.Count</strong> kept separate · <strong>@_result.Report.OutputRows</strong> records in the cleaned preview.</p>
                <button class="btn btn-outline-secondary" @onclick="ReviewAgain">Review decisions</button>
            }
            else
            {
                var group = _result.Duplicates.Groups[Math.Min(_reviewIndex, _result.Duplicates.Groups.Count - 1)];
                var id = group.RowIndices[0];
                var draft = _drafts[id];
                <div class="gs-review-filters" aria-label="Duplicate group filters">
                    <button class="@FilterButtonClass("all")" @onclick='() => SetReviewFilter("all")'>All (@_result.Duplicates.Groups.Count)</button>
                    <button class="@FilterButtonClass("identical")" @onclick='() => SetReviewFilter("identical")'>Identical (@CountKind(DuplicateGroupKind.Identical))</button>
                    <button class="@FilterButtonClass("complementary")" @onclick='() => SetReviewFilter("complementary")'>Missing info (@CountKind(DuplicateGroupKind.Complementary))</button>
                    <button class="@FilterButtonClass("conflicting")" @onclick='() => SetReviewFilter("conflicting")'>Disagreements (@CountKind(DuplicateGroupKind.Conflicting))</button>
                </div>
                <div class="gs-review-toolbar">
                    <div class="gs-page-kicker">DUPLICATE @(_reviewIndex + 1) OF @_result.Duplicates.Groups.Count · @UnreviewedCount undecided</div>
                    <div class="gs-review-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PreviousGroup" disabled="@(_reviewIndex == 0)">← Previous</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NextGroup" disabled="@(_reviewIndex >= _result.Duplicates.Groups.Count - 1)">Next →</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="JumpToNextUnreviewed" disabled="@(UnreviewedCount == 0)">Next undecided</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="NextFilteredGroup">Next in filter</button>
                    </div>
                </div>
                <div class="gs-review-jump">
                    <label for="gs-review-id" class="form-label">Find a Site / ID</label>
                    <input id="gs-review-id" class="form-control" placeholder="Enter exact identifier" @bind="_jumpIdentifier" @bind:event="oninput" />
                    <button type="button" class="btn btn-outline-primary" @onclick="JumpToIdentifier">Go to record</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_jumpMessage))
                {
                    <p class="gs-note" role="status">@_jumpMessage</p>
                }
                @if (_decisions.ContainsKey(id))
                {
                    <div class="alert alert-info">This group was already combined. Confirm a different choice to replace the decision, or keep the existing result.</div>
                }
                else if (_skipped.Contains(id))
                {
                    <div class="alert alert-info">This group is currently kept separate. You can review it again and choose to combine it.</div>
                }
                <h3 class="mt-2">Site / ID: @string.Join(", ", group.Key.Values)</h3>
                <div class="progress mb-4" role="progressbar" aria-label="Review progress" aria-valuenow="@(_reviewIndex + 1)" aria-valuemin="0" aria-valuemax="@_result.Duplicates.Groups.Count">
                    <div class="progress-bar" style="@($"width:{100.0 * (_reviewIndex + 1) / _result.Duplicates.Groups.Count:F1}%")"></div>
                </div>
                @if (!_showSummary && group.HasConflicts)
                {
                    var column = group.ConflictingColumns[_questionIndex];
                    var values = group.RowIndices.Select(index =>
                        _result.Merged.Rows[index].Columns.TryGetValue(column, out var cell) ? cell : null).ToArray();
                    var hasMissing = values.Any(string.IsNullOrWhiteSpace);
                    var hasPresent = values.Any(value => !string.IsNullOrWhiteSpace(value));
                    var fillingGap = hasMissing && hasPresent;
                    <h4>@(fillingGap ? $"We found missing {column} information" : $"Which {column} value is correct?")</h4>
                    <p class="gs-note">@(fillingGap
                        ? "One file has information that another is missing. Choose the value you want to keep. GeoShift won't fill it in without your confirmation."
                        : "The files disagree. Pick the correct value, or keep both records if you're unsure.")</p>
                    @foreach (var index in group.RowIndices)
                    {
                        var row = _result.Merged.Rows[index];
                        var value = row.Columns.TryGetValue(column, out var cell) ? cell : null;
                        <label class="d-block border rounded p-3 mb-2" style="cursor:pointer">
                            <input type="radio" name="@($"answer-{id}-{_questionIndex}")" checked="@(draft.Sources.TryGetValue(column, out var selected) && selected == index)" @onchange="() => ChooseAnswer(id, column, index)" />
                            <strong class="ms-2">@(string.IsNullOrWhiteSpace(value) ? "(No value)" : value)</strong>
                            <span class="gs-note ms-4 d-block">@row.SourceDataset · row @row.SourceRowNumber</span>
                        </label>
                    }
                    <button class="btn btn-primary mt-3" disabled="@(!draft.Sources.ContainsKey(column))" @onclick="NextQuestion">Continue →</button>
                }
                else
                {
                    <h4>@(group.HasConflicts ? "Does this look right?" : "These records match. Keep one copy?")</h4>
                    <p class="gs-note">Review every value below before confirming. Empty values stay empty if you selected them. Your uploaded files remain unchanged.</p>
                    <div class="gs-preview-table mb-3">
                        <table class="table table-hover">
                            <tbody>
                                @foreach (var column in _result.Merged.Columns)
                                {
                                    var row = _result.Merged.Rows[GetSource(id, column)];
                                    <tr><th scope="row">@column</th><td>@(row.Columns.TryGetValue(column, out var value) ? value : "")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-primary" @onclick="() => Approve(id)">Confirm &amp; next →</button>
                }
                <div class="mt-3">
                    <a href="#" @onclick="() => Skip(id)" @onclick:preventDefault="true">I'm not sure — keep both records</a>
                </div>
                @if (_questionIndex > 0 || _showSummary)
                {
                    <div class="mt-2"><a href="#" @onclick="BackOneStep" @onclick:preventDefault="true">← Change my answer</a></div>
                }
                <p class="gs-note mt-4">@_decisions.Count confirmed · @_skipped.Count kept separate · @_result.Report.OutputRows output records</p>
            }
        </section>
        <section class="gs-panel">
