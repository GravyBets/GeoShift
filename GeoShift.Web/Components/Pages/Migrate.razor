@code {
    private sealed record CheckpointDecision(int Group, int Keep, Dictionary<string,int> Sources);
    private sealed record ReviewCheckpoint(string Fingerprint, List<CheckpointDecision> Decisions, List<int> Skipped, int Position);
    private string? _checkpointMessage;
    private bool _restoringCheckpoint;
    private bool _checkpointCleared;
    private bool _checkpointNeedsRestore;
    private bool _checkpointOverwriteConfirmed;
    private string _reviewFilter = "all";
    private bool CanChangeReview => !_checkpointNeedsRestore && !_restoringCheckpoint;
    private bool MatchesReviewFilter(DuplicateGroup group)
    {
        if (_result is null) return false;
        var id = group.RowIndices[0];
        return _reviewFilter switch
        {
            "undecided" => !_decisions.ContainsKey(id) && !_skipped.Contains(id),
            "identical" => DuplicateGroupClassifier.Classify(_result.Merged, group).Kind == DuplicateGroupKind.Identical,
            "complementary" => DuplicateGroupClassifier.Classify(_result.Merged, group).Kind == DuplicateGroupKind.Complementary,
            "conflicting" => DuplicateGroupClassifier.Classify(_result.Merged, group).Kind == DuplicateGroupKind.Conflicting,
            "combined" => _decisions.ContainsKey(id),
            "separate" => _skipped.Contains(id),
            _ => true
        };
    }
    private void SetReviewFilter(string filter)
    {
        _reviewFilter = filter;
        if (_result is null) return;
        var index = _result.Duplicates.Groups.ToList().FindIndex(MatchesReviewFilter);
        if (index >= 0) JumpToGroup(index);
        else _jumpMessage = "No groups match this filter.";
    }
    private void NextFilteredGroup()
    {
        if (_result is null) return;
        var groups = _result.Duplicates.Groups;
        for (var offset = 1; offset <= groups.Count; offset++)
        {
            var index = (_reviewIndex + offset) % groups.Count;
            if (MatchesReviewFilter(groups[index])) { JumpToGroup(index); return; }
        }
        _jumpMessage = "No groups match this filter.";
    }
    private string DatasetFingerprint()
    {
        var builder = new StringBuilder();
        foreach (var dataset in _datasets)
        {
            builder.Append(dataset.Name).Append('|').Append(dataset.Rows.Count).Append('|')
                .Append(dataset.KeyColumn).Append('|');
            foreach (var column in dataset.Columns)
                builder.Append(column).Append('=').Append(dataset.OutputNames[column]).Append('|');
            foreach (var row in dataset.Rows)
                foreach (var column in dataset.Columns)
                {
                    row.TryGetValue(column, out var value);
                    builder.Append(value?.Length ?? -1).Append(':').Append(value).Append('|');
                }
        }
        return Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
            Encoding.UTF8.GetBytes(builder.ToString())));
    }
    private async Task SaveCheckpoint()
    {
        if (_result is null || _restoringCheckpoint || _checkpointCleared || _checkpointNeedsRestore) return;
        var groups = _result.Duplicates.Groups;
        var decisions = groups.Select((g, i) => (g, i))
            .Where(x => _decisions.ContainsKey(x.g.RowIndices[0]))
            .Select(x => {
                var d = _decisions[x.g.RowIndices[0]];
                return new CheckpointDecision(x.i, d.KeepRowIndex, new Dictionary<string,int>(d.ColumnSources));
            }).ToList();
        var skipped = groups.Select((g, i) => (g, i))
            .Where(x => _skipped.Contains(x.g.RowIndices[0])).Select(x => x.i).ToList();
        try
        {
            await JS.InvokeVoidAsync("geoShiftReviewCheckpoint.save",
                JsonSerializer.Serialize(new ReviewCheckpoint(DatasetFingerprint(), decisions, skipped, _reviewIndex)));
            _checkpointMessage = "Progress saved in this tab. Reupload matching files after refreshing to restore it.";
            _checkpointOverwriteConfirmed = false;
        }
        catch (Exception) { _checkpointMessage = "Could not save decisions in this browser tab."; }
    }
    private async Task RestoreCheckpoint()
    {
        if (_result is null) { _checkpointMessage = "Upload the same files and preview the migration first."; return; }
        try
        {
            var json = await JS.InvokeAsync<string?>("geoShiftReviewCheckpoint.load");
            if (string.IsNullOrWhiteSpace(json)) { _checkpointMessage = "No saved review in this browser tab."; return; }
            var saved = JsonSerializer.Deserialize<ReviewCheckpoint>(json);
            if (saved is null || saved.Fingerprint != DatasetFingerprint())
            {
                _checkpointMessage = "Files or column mappings differ from the saved review. No decisions restored.";
                return;
            }
            var groups = _result.Duplicates.Groups;
            var restored = new Dictionary<int, ConflictResolutionDecision>();
            foreach (var item in saved.Decisions)
            {
                if (item.Group < 0 || item.Group >= groups.Count) return;
                var g = groups[item.Group];
                if (!g.RowIndices.Contains(item.Keep) || item.Sources.Any(x =>
                    !g.RowIndices.Contains(x.Value) || !g.ConflictingColumns.Contains(x.Key))) return;
                restored[g.RowIndices[0]] = new ConflictResolutionDecision(item.Keep,
                    new Dictionary<string,int>(item.Sources));
            }
            _restoringCheckpoint = true;
            _decisions.Clear();
            foreach (var d in restored) _decisions.Add(d.Key, d.Value);
            _skipped.Clear();
            foreach (var index in saved.Skipped)
                if (index >= 0 && index < groups.Count && !_decisions.ContainsKey(groups[index].RowIndices[0]))
                    _skipped.Add(groups[index].RowIndices[0]);
            RefreshResolution();
            _reviewIndex = Math.Clamp(saved.Position, 0, groups.Count);
            _questionIndex = 0;
            _showSummary = false;
            _restoringCheckpoint = false;
            _checkpointCleared = false;
            _checkpointNeedsRestore = false;
            _checkpointOverwriteConfirmed = false;
            _checkpointMessage = $"Restored {_decisions.Count} merges and {_skipped.Count} keep-separate decisions.";
        }
        catch (Exception) { _checkpointMessage = "Could not restore the saved review."; }
        finally { _restoringCheckpoint = false; }
    }
    private async Task ClearCheckpoint()
    {
        try
        {
            await JS.InvokeVoidAsync("geoShiftReviewCheckpoint.clear");
            _checkpointCleared = true;
            _checkpointNeedsRestore = false;
            _checkpointMessage = "Saved review cleared. Save again to create a new checkpoint.";
        }
        catch (Exception) { _checkpointMessage = "Could not clear saved review."; }
    }

    private async Task CheckExistingCheckpoint()
    {
        if (_result is null) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("geoShiftReviewCheckpoint.load");
            if (string.IsNullOrWhiteSpace(json))
            {
                _checkpointNeedsRestore = false;
                return;
            }
            var saved = JsonSerializer.Deserialize<ReviewCheckpoint>(json);
            if (saved is null)
            {
                _checkpointNeedsRestore = true;
                _checkpointMessage = "Saved review is unreadable. Clear it or confirm a fresh start.";
                return;
            }
            _checkpointNeedsRestore = true;
            _checkpointMessage = saved.Fingerprint == DatasetFingerprint()
                ? "Saved review found for these files. Restore it or explicitly start a new review before changing decisions."
                : "A saved review exists for different files or mappings. It will not be overwritten automatically.";
        }
        catch (Exception) { _checkpointNeedsRestore = true; _checkpointMessage = "Could not check saved review. Review changes remain paused."; }
    }

    private void StartFreshCheckpoint()
    {
        if (!_checkpointOverwriteConfirmed || !_checkpointNeedsRestore) return;
        _checkpointNeedsRestore = false;
        _checkpointCleared = false;
        _checkpointOverwriteConfirmed = false;
        _checkpointMessage = "New review started. Your next decision will replace the previous saved checkpoint.";
    }

    private sealed record SavedFileMapping(string FileName, string KeyColumn, Dictionary<string, string> OutputNames);
    private sealed record SavedMappingTemplate(string Name, List<SavedFileMapping> Files);

    private List<SavedMappingTemplate> _templates = [];
    private string _selectedTemplate = "";
    private string _newTemplateName = "";
    private string? _templateMessage;

    private async Task LoadTemplates()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("geoShiftMappingTemplates.load");
            _templates = JsonSerializer.Deserialize<List<SavedMappingTemplate>>(json) ?? [];
            _templateMessage = $"Loaded {_templates.Count} templates from this browser.";
        }
        catch (Exception)
        {
            _templateMessage = "Could not read saved templates from this browser.";
        }
    }

    private async Task SaveTemplate()
    {
        var name = _newTemplateName.Trim();
        if (name.Length == 0 || name.Length > 80 || _datasets.Count == 0) return;
        await LoadTemplates();
        if (_templates.Any(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _templateMessage = "A template with this name already exists. Choose another name.";
            return;
        }
        var files = _datasets.Select(d => new SavedFileMapping(d.Name, d.KeyColumn,
            new Dictionary<string, string>(d.OutputNames, StringComparer.OrdinalIgnoreCase))).ToList();
        _templates.Add(new SavedMappingTemplate(name, files));
        try
        {
            await JS.InvokeVoidAsync("geoShiftMappingTemplates.save", JsonSerializer.Serialize(_templates));
            _selectedTemplate = name;
            _newTemplateName = "";
            _templateMessage = "Mapping template saved in this browser.";
        }
        catch (Exception)
        {
            _templates.RemoveAll(t => t.Name == name);
            _templateMessage = "Could not save the template. Browser storage may be disabled.";
        }
    }

    private void ApplyTemplate()
    {
        var template = _templates.FirstOrDefault(t => t.Name == _selectedTemplate);
        if (template is null) return;
        // Validate all files and columns before modifying anything.
        if (template.Files.Count != _datasets.Count ||
            template.Files.Any(saved =>
                !_datasets.Any(current => string.Equals(current.Name, saved.FileName, StringComparison.OrdinalIgnoreCase) &&
                    current.Columns.Contains(saved.KeyColumn) &&
                    current.Columns.Count == saved.OutputNames.Count &&
                    current.Columns.All(column => saved.OutputNames.ContainsKey(column)))))
        {
            _templateMessage = "Template does not match these filenames and columns. Nothing was changed.";
            return;
        }
        foreach (var dataset in _datasets)
        {
            var saved = template.Files.First(f => string.Equals(f.FileName, dataset.Name, StringComparison.OrdinalIgnoreCase));
            dataset.KeyColumn = saved.KeyColumn;
            foreach (var column in dataset.Columns) dataset.OutputNames[column] = saved.OutputNames[column];
        }
        _result = null;
        _requiredColumns.Clear();
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        _confirmMappings = false;
        _templateMessage = "Template applied. Review the mappings before previewing.";
    }

    private async Task DeleteTemplate()
    {
        var template = _templates.FirstOrDefault(t => t.Name == _selectedTemplate);
        if (template is null) return;
        var remaining = _templates.Where(t => t.Name != template.Name).ToList();
        try
        {
            await JS.InvokeVoidAsync("geoShiftMappingTemplates.save", JsonSerializer.Serialize(remaining));
            _templates = remaining;
            _selectedTemplate = "";
            _templateMessage = "Template deleted from this browser.";
        }
        catch (Exception)
        {
            _templateMessage = "Could not delete the template.";
        }
    }

    private sealed class UploadedDataset
    {
