    private int CountKind(DuplicateGroupKind kind) => _result is null ? 0 :
        _result.Duplicates.Groups.Count(group => DuplicateGroupClassifier.Classify(_result.Merged, group).Kind == kind);

    private string DescribeKind(DuplicateGroup group)
    {
        if (_result is null) return "";
        var classification = DuplicateGroupClassifier.Classify(_result.Merged, group);
        return classification.Kind switch
        {
            DuplicateGroupKind.Identical => "Identical",
            DuplicateGroupKind.Complementary => "Missing information",
            _ => "Conflicting values"
        };
    }

    private string _reviewFilter = "all";
    private string FilterButtonClass(string filter) => _reviewFilter == filter
        ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
    private bool MatchesReviewFilter(DuplicateGroup group) => _reviewFilter switch
    {
        "identical" => DuplicateGroupClassifier.Classify(_result!.Merged, group).Kind == DuplicateGroupKind.Identical,
        "complementary" => DuplicateGroupClassifier.Classify(_result!.Merged, group).Kind == DuplicateGroupKind.Complementary,
        "conflicting" => DuplicateGroupClassifier.Classify(_result!.Merged, group).Kind == DuplicateGroupKind.Conflicting,
        _ => true
    };
    private void SetReviewFilter(string filter)
    {
        if (_result is null) return;
        _reviewFilter = filter;
        var groups = _result.Duplicates.Groups;
        var index = Enumerable.Range(0, groups.Count)
            .FirstOrDefault(i => MatchesReviewFilter(groups[i]) &&
                !_decisions.ContainsKey(groups[i].RowIndices[0]) &&
                !_skipped.Contains(groups[i].RowIndices[0]), -1);
        if (index < 0) index = Enumerable.Range(0, groups.Count)
            .FirstOrDefault(i => MatchesReviewFilter(groups[i]), -1);
        if (index >= 0) JumpToGroup(index);
        else _jumpMessage = "No groups match this filter.";
    }
    private bool _confirmKeepRemaining;
    private int UnreviewedCount => _result is null ? 0 :
        _result.Duplicates.Groups.Count(g => !_decisions.ContainsKey(g.RowIndices[0]) && !_skipped.Contains(g.RowIndices[0]));
    private void KeepRemainingSeparate()
    {
        if (_result is null || !_confirmKeepRemaining || !CanChangeReview) return;
        foreach (var group in _result.Duplicates.Groups)
        {
            var id = group.RowIndices[0];
            if (!_decisions.ContainsKey(id)) _skipped.Add(id);
        }
        _confirmKeepRemaining = false;
        _reviewIndex = _result.Duplicates.Groups.Count;
        _questionIndex = 0;
        _showSummary = false;
        RefreshResolution();
    }

    private bool _confirmExact;
    private int ExactPendingCount => _result is null ? 0 : _result.Duplicates.Groups.Count(g => !g.HasConflicts && !_decisions.ContainsKey(g.RowIndices[0]) && !_skipped.Contains(g.RowIndices[0]));
    private void ApproveExactMatches()
    {
        if (_result is null || !CanChangeReview) return;
        foreach (var group in _result.Duplicates.Groups.Where(g => !g.HasConflicts))
        {
            var id = group.RowIndices[0];
            if (_skipped.Contains(id) || _decisions.ContainsKey(id)) continue;
            _decisions[id] = new ConflictResolutionDecision(id, new Dictionary<string, int>());
        }
        _confirmExact = false;
        RefreshResolution();
        while (_reviewIndex < _result.Duplicates.Groups.Count && _decisions.ContainsKey(_result.Duplicates.Groups[_reviewIndex].RowIndices[0])) _reviewIndex++;
    }
    private bool _confirmRecoverable;
    private sealed record RecoverableProposal(DuplicateGroup Group, Dictionary<string, int> Fills);
    private List<RecoverableProposal> RecoverableProposals
    {
        get
        {
            var proposals = new List<RecoverableProposal>();
            if (_result is null) return proposals;
            foreach (var group in _result.Duplicates.Groups)
            {
                var id = group.RowIndices[0];
                if (_decisions.ContainsKey(id) || _skipped.Contains(id) ||
                    DuplicateGroupClassifier.Classify(_result.Merged, group).Kind != DuplicateGroupKind.Complementary)
                    continue;
                var fills = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                var safe = true;
                foreach (var column in group.ConflictingColumns)
                {
                    var present = group.RowIndices.Where(i =>
                        _result.Merged.Rows[i].Columns.TryGetValue(column, out var value) &&
                        !string.IsNullOrWhiteSpace(value)).ToArray();
                    var unique = present.Select(i => _result.Merged.Rows[i].Columns[column])
                        .Distinct(StringComparer.Ordinal).ToArray();
                    if (present.Length == 0 || unique.Length != 1) { safe = false; break; }
                    fills[column] = present[0];
                }
                if (safe && fills.Count > 0) proposals.Add(new RecoverableProposal(group, fills));
            }
            return proposals;
        }
    }
    private int RecoverablePendingCount => RecoverableProposals.Count;
    private void ApproveRecoverable()
    {
        if (_result is null || !_confirmRecoverable || !CanChangeReview) return;
        var proposals = RecoverableProposals;
        foreach (var proposal in proposals)
        {
            var id = proposal.Group.RowIndices[0];
            _decisions[id] = new ConflictResolutionDecision(id,
                new Dictionary<string, int>(proposal.Fills, StringComparer.OrdinalIgnoreCase));
            _skipped.Remove(id);
        }
        _confirmRecoverable = false;
        RefreshResolution();
        while (_reviewIndex < _result.Duplicates.Groups.Count &&
               (_decisions.ContainsKey(_result.Duplicates.Groups[_reviewIndex].RowIndices[0]) ||
                _skipped.Contains(_result.Duplicates.Groups[_reviewIndex].RowIndices[0])))
            _reviewIndex++;
        _questionIndex = 0;
        _showSummary = false;
    }
    private int _reviewIndex;
    private string _jumpIdentifier = "";
    private string? _jumpMessage;
    private int _questionIndex;
    private bool _showSummary;
    private bool ReviewComplete => _result is not null &&
        _result.Duplicates.Groups.All(g => _decisions.ContainsKey(g.RowIndices[0]) || _skipped.Contains(g.RowIndices[0]));
    private readonly HashSet<int> _skipped = [];

    private sealed class DraftDecision
    {
        public int KeepRow { get; set; }
        public Dictionary<string, int> Sources { get; } = new(StringComparer.OrdinalIgnoreCase);
    }
    private readonly Dictionary<int, DraftDecision> _drafts = [];
    private readonly Dictionary<int, ConflictResolutionDecision> _decisions = [];

    private int GetSource(int id, string column) =>
        _drafts[id].Sources.TryGetValue(column, out var index) ? index : _drafts[id].KeepRow;

    private void ChooseAnswer(int id, string column, int index)
    {
        if (_result is null || !CanChangeReview) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (!group.RowIndices.Contains(index) || !group.ConflictingColumns.Contains(column)) return;
        _drafts[id].Sources[column] = index;
        _decisions.Remove(id);
        _skipped.Remove(id);
        _showSummary = false;
        RefreshResolution();
    }

    private void BackOneStep()
    {
        if (_showSummary) { _showSummary = false; _questionIndex = Math.Max(0, _questionIndex); }
        else if (_questionIndex > 0) _questionIndex--;
    }

    private void ReviewAgain()
    {
        JumpToGroup(0);
    }

    private void JumpToGroup(int index)
    {
        if (_result is null || index < 0 || index >= _result.Duplicates.Groups.Count) return;
        _reviewIndex = index;
        _questionIndex = 0;
        _showSummary = false;
        _jumpMessage = null;
    }

    private void JumpToNextUnreviewed()
    {
        if (_result is null) return;
        var groups = _result.Duplicates.Groups;
        for (var offset = 1; offset <= groups.Count; offset++)
        {
            var index = (_reviewIndex + offset) % groups.Count;
            var id = groups[index].RowIndices[0];
            if (_decisions.ContainsKey(id) || _skipped.Contains(id) || !MatchesReviewFilter(groups[index])) continue;
            JumpToGroup(index);
            return;
        }
        _jumpMessage = "All duplicate groups have a decision.";
    }

    private void JumpToIdentifier()
    {
        if (_result is null || string.IsNullOrWhiteSpace(_jumpIdentifier)) return;
        var query = _jumpIdentifier.Trim();
        var index = _result.Duplicates.Groups.ToList().FindIndex(g =>
            string.Equals(string.Join(", ", g.Key.Values), query, StringComparison.OrdinalIgnoreCase));
        if (index >= 0) JumpToGroup(index);
        else _jumpMessage = $"No duplicate group matches '{query}'. Enter the exact Site / ID.";
    }

    private void NextQuestion()
    {
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (_questionIndex < group.ConflictingColumns.Count - 1)
            _questionIndex++;
        else if (group.ConflictingColumns.All(column => _drafts[group.RowIndices[0]].Sources.ContainsKey(column)))
            _showSummary = true;
    }

    private void Approve(int id)
    {
        if (!CanChangeReview) return;
        var draft = _drafts[id];
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (group.ConflictingColumns.Any(column => !draft.Sources.ContainsKey(column))) return;
        _decisions[id] = new ConflictResolutionDecision(draft.KeepRow,
            new Dictionary<string, int>(draft.Sources, StringComparer.OrdinalIgnoreCase));
        _skipped.Remove(id);
        RefreshResolution();
        NextGroup();
    }

    private void Undo(int id) { if (!CanChangeReview) return; _decisions.Remove(id); RefreshResolution(); }
    private void Skip(int id)
    {
        if (!CanChangeReview) return;
        _decisions.Remove(id);
        _skipped.Add(id);
        RefreshResolution();
        NextGroup();
    }
    private void PreviousGroup()
    {
        if (_result is null) return;
        for (var index = _reviewIndex - 1; index >= 0; index--)
            if (MatchesReviewFilter(_result.Duplicates.Groups[index])) { JumpToGroup(index); return; }
    }

    private void NextGroup()
    {
        if (_result is null) return;
        var next = Enumerable.Range(Math.Min(_reviewIndex + 1, _result.Duplicates.Groups.Count),
            Math.Max(0, _result.Duplicates.Groups.Count - _reviewIndex - 1))
            .FirstOrDefault(i => MatchesReviewFilter(_result.Duplicates.Groups[i]), -1);
        if (next >= 0)
            JumpToGroup(next);
        else
        {
            _reviewIndex = _result.Duplicates.Groups.Count;
            _questionIndex = 0;
            _showSummary = false;
        }
    }
    private void ResetDecisions()
    {
        if (!CanChangeReview) return;
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        RefreshResolution();
    }

    private void RefreshResolution()
    {
        if (_result is null) return;
        _corrections.Clear();
        _editingIssue = null;
        try
        {
            var resolved = new ConflictResolutionEngine().Resolve(
                _result.Merged, _result.Duplicates, _decisions.Values.ToArray());
            var report = new MigrationReportEngine().Build(_result.Merged, _result.Duplicates, resolved);
            _result = _result with { Resolved = resolved, Report = report };
            _error = null;
            if (!_restoringCheckpoint && !_checkpointCleared) _ = InvokeAsync(SaveCheckpoint);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidDataException)
        {
            _error = ex.Message;
        }
    }


    private async Task LoadFiles(InputFileChangeEventArgs args)
    {
        _busy = true;
        _error = null;
        _result = null;
        _datasets.Clear();
        _corrections.Clear();
        _editingIssue = null;
        _requiredColumns.Clear();
        _confirmMappings = false;
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        _jumpIdentifier = "";
        _jumpMessage = null;
        _confirmKeepRemaining = false;
        _confirmExact = false;
        _confirmRecoverable = false;
        try
        {
            var files = args.GetMultipleFiles(3);
            foreach (var file in files)
            {
                if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase) &&
                    !file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
                    throw new InvalidDataException("Only CSV and XLSX files are supported.");
                await using var stream = file.OpenReadStream(2 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                IReadOnlyList<IReadOnlyDictionary<string, string?>> rows;
                if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
                    rows = MigrationXlsxReader.Read(buffer);
                else
                {
                    using var reader = new StreamReader(buffer);
                    rows = MigrationCsvReader.Read(reader);
                }
                var columns = rows.Count > 0 ? rows[0].Keys.ToArray() : Array.Empty<string>();
                if (columns.Length == 0)
                    throw new InvalidDataException($"'{file.Name}' has no data rows.");
                var uploaded = new UploadedDataset
                {
                    Name = file.Name,
                    Rows = rows,
                    Columns = columns,
                    KeyColumn = columns[0]
                };
                foreach (var column in columns) uploaded.OutputNames[column] = column;
                _datasets.Add(uploaded);
            }
            if (_datasets.Select(x => x.Name).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _datasets.Count)
                throw new InvalidDataException("Files must have distinct names.");
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException)
        {
            _datasets.Clear();
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private void SetOutputName(UploadedDataset dataset, string column, string? name)
    {
        if (!dataset.Columns.Contains(column)) return;
        dataset.OutputNames[column] = name?.Trim() ?? "";
        _confirmMappings = false;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
    }

    private void SetKey(UploadedDataset dataset, string? column)
    {
        if (column is not null && dataset.Columns.Contains(column)) dataset.KeyColumn = column;
        _confirmMappings = false;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
    }

    private async Task PreviewAndCheckCheckpoint()
    {
        RunPreview();
        if (_result is not null) await CheckExistingCheckpoint();
    }

    private void RunPreview()
    {
        _corrections.Clear();
        _editingIssue = null;
        _error = null;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        _reviewFilter = "all";
        try
        {
            foreach (var dataset in _datasets)
            {
                var targets = dataset.Columns.Select(column =>
                    column == dataset.KeyColumn ? "GeoShift Match Key" : dataset.OutputNames[column]).ToArray();
                if (targets.Any(string.IsNullOrWhiteSpace))
                    throw new InvalidDataException($"Every output column in '{dataset.Name}' needs a name.");
                if (targets.Distinct(StringComparer.OrdinalIgnoreCase).Count() != targets.Length)
                    throw new InvalidDataException($"'{dataset.Name}' maps multiple columns to the same output name. Give each field a unique name.");
            }
            var inputs = _datasets.Select(d => new MigrationWorkflowDataset(
                d.Name, d.Rows,
                d.Columns.Select(column => new ColumnMappingRule(column,
                    column == d.KeyColumn ? "GeoShift Match Key" : d.OutputNames[column])).ToArray())).ToArray();
            _result = new MigrationWorkflowEngine().Execute(
                new MigrationWorkflowRequest(inputs, ["GeoShift Match Key"], []));
            _requiredColumns.Clear();
            _requiredColumns.Add("GeoShift Match Key");
            _checkpointCleared = false;
            _checkpointNeedsRestore = true;
            foreach (var group in _result.Duplicates.Groups)
                _drafts.Add(group.RowIndices[0], new DraftDecision { KeepRow = group.RowIndices[0] });
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException)
        {
            _error = ex.Message;
        }
    }
}
