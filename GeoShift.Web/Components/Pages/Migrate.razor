    }

    private bool _confirmMappings;
    private IReadOnlyList<ColumnNameSuggestion> PendingNameSuggestions
    {
        get
        {
            var candidates = ColumnNameSuggester.Suggest(_datasets.Select(dataset =>
                new ColumnNameDataset(dataset.Columns, dataset.KeyColumn)).ToArray());
            return candidates.Where(suggestion =>
            {
                var dataset = _datasets[suggestion.DatasetIndex];
                // Respect manual edits and avoid overwriting an existing target column.
                return string.Equals(dataset.OutputNames[suggestion.SourceColumn], suggestion.SourceColumn, StringComparison.Ordinal) &&
                    !dataset.Columns.Where(column => column != suggestion.SourceColumn && column != dataset.KeyColumn)
                        .Any(column => string.Equals(dataset.OutputNames[column], suggestion.SuggestedOutputColumn, StringComparison.OrdinalIgnoreCase));
            }).ToArray();
        }
    }

    private void ApplyNameSuggestions()
    {
        foreach (var suggestion in PendingNameSuggestions)
            _datasets[suggestion.DatasetIndex].OutputNames[suggestion.SourceColumn] = suggestion.SuggestedOutputColumn;
        _confirmMappings = false;
        _result = null;
        _decisions.Clear();
        _skipped.Clear();
        _drafts.Clear();
    }

