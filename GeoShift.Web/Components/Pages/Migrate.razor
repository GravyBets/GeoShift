@page "/migrate"
@rendermode InteractiveServer
@using GeoShift.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text
@inject IJSRuntime JS

<PageTitle>Migration Workspace — GeoShift</PageTitle>
<div class="gs-container gs-workspace">
    <div class="gs-page-kicker">DATA MIGRATION WORKSPACE</div>
    <h1 class="gs-page-title">Merge and review your data.</h1>
    <p class="gs-page-description">Upload up to three CSV or Excel files, map equivalent identifier columns, and preview duplicates. This workspace never automatically removes records.</p>

    <section class="gs-panel">
        <div class="gs-panel-heading"><h2>Import CSV or Excel files</h2><span class="gs-step">STEP 01</span></div>
        <InputFile OnChange="LoadFiles" multiple accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@_busy" />
        <p class="gs-note">Up to 3 CSV or XLSX files, 2 MB per file, 5,000 data rows per file. Excel uses the first worksheet; formula cells are not supported. Files are processed in memory for this preview.</p>
        @foreach (var dataset in _datasets)
        {
            <div class="gs-file-info"><strong>@dataset.Name</strong><span> · @dataset.Rows.Count rows</span></div>
        }
    </section>

    @if (_datasets.Count > 0)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Match identifier columns</h2><span class="gs-step">STEP 02</span></div>
            <p class="gs-note">Choose the column representing the same identifier in each file. For example, Site # and Location ID.</p>
            @foreach (var dataset in _datasets)
            {
                <div class="mb-3">
                    <label class="form-label">@dataset.Name</label>
                    <select class="form-select" value="@dataset.KeyColumn" @onchange="e => SetKey(dataset, e.Value?.ToString())">
                        @foreach (var column in dataset.Columns)
                        {
                            <option value="@column">@column</option>
                        }
                    </select>
                </div>
            }
            <details class="border rounded p-3 mb-3">
                <summary><strong>Match other column names (optional)</strong></summary>
                <p class="gs-note mt-2">Give equivalent fields the same output name. For example, rename RadioSerialNumber to RadioSN. Leave unrelated fields unchanged.</p>
                @foreach (var dataset in _datasets)
                {
                    <h4 class="mt-3">@dataset.Name</h4>
                    @foreach (var column in dataset.Columns.Where(column => column != dataset.KeyColumn))
                    {
                        <div class="row align-items-center mb-2">
                            <label class="col-sm-5 col-form-label">@column</label>
                            <div class="col-sm-7">
                                <input class="form-control" aria-label="@($"Output name for {column} in {dataset.Name}")"
                                       value="@dataset.OutputNames[column]"
                                       @onchange="e => SetOutputName(dataset, column, e.Value?.ToString())" />
                            </div>
                        </div>
                    }
                }
            </details>
            <button class="btn btn-primary" @onclick="RunPreview" disabled="@_busy">Preview migration →</button>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_result is not null)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Migration report</h2><span class="gs-step">STEP 03</span></div>
            <div class="gs-stats">
                <div class="gs-stat"><div class="gs-stat-label">Imported</div><div class="gs-stat-value">@_result.Report.ImportedRows</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Duplicate groups</div><div class="gs-stat-value">@_result.Report.DuplicateGroups</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Identical</div><div class="gs-stat-value">@CountKind(DuplicateGroupKind.Identical)</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Missing information</div><div class="gs-stat-value">@CountKind(DuplicateGroupKind.Complementary)</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Disagreements</div><div class="gs-stat-value">@CountKind(DuplicateGroupKind.Conflicting)</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Missing keys</div><div class="gs-stat-value">@_result.Report.RowsMissingMatchKeys</div></div>
            </div>
            <p class="gs-note">No records are consolidated without your approval.</p>
            @if (ExactPendingCount > 0)
            {
                <div class="border rounded p-3 mb-3">
                    <strong>@ExactPendingCount identical duplicate groups</strong>
                    <p class="gs-note">All fields match. Approve these together instead of reviewing each one.</p>
                    @if (!_confirmExact)
                    {
                        <button class="btn btn-outline-primary" @onclick="() => _confirmExact = true">Review exact matches</button>
                    }
                    else
                    {
                        <p>Combine @ExactPendingCount groups into one record each? Original uploads remain unchanged.</p>
                        <button class="btn btn-primary me-2" @onclick="ApproveExactMatches">Confirm exact matches</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _confirmExact = false">Cancel</button>
                    }
                </div>
            }
            <div class="gs-preview-table">
                <table class="table table-hover">
                    <thead><tr><th>Identifier</th><th>Records</th><th>Review type</th><th>Fields to review</th></tr></thead>
                    <tbody>
                        @foreach (var group in _result.Duplicates.Groups.Take(20))
                        {
                            <tr>
                                <td>@string.Join(", ", group.Key.Values)</td>
                                <td>@group.RowIndices.Count</td>
                                <td>@DescribeKind(group)</td>
                                <td>@(group.HasConflicts ? string.Join(", ", group.ConflictingColumns) : "None")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Clean up duplicates</h2><span class="gs-step">STEP 04</span></div>
            @if (_result.Duplicates.Groups.Count == 0)
            {
                <p>No duplicate records found.</p>
            }
            else if (ReviewComplete)
            {
                <h3>You're all caught up!</h3>
                <p>You've reviewed all @_result.Duplicates.Groups.Count duplicate groups.</p>
                <p><strong>@_decisions.Count</strong> combined · <strong>@_skipped.Count</strong> kept separate · <strong>@_result.Report.OutputRows</strong> records in the cleaned preview.</p>
                <button class="btn btn-outline-secondary" @onclick="ReviewAgain">Review decisions</button>
            }
            else
            {
                var group = _result.Duplicates.Groups[_reviewIndex];
                var id = group.RowIndices[0];
                var draft = _drafts[id];
                <div class="gs-page-kicker">DUPLICATE @(_reviewIndex + 1) OF @_result.Duplicates.Groups.Count</div>
                <h3 class="mt-2">Site / ID: @string.Join(", ", group.Key.Values)</h3>
                <div class="progress mb-4" role="progressbar" aria-label="Review progress" aria-valuenow="@(_reviewIndex + 1)" aria-valuemin="0" aria-valuemax="@_result.Duplicates.Groups.Count">
                    <div class="progress-bar" style="@($"width:{100.0 * (_reviewIndex + 1) / _result.Duplicates.Groups.Count:F1}%")"></div>
                </div>
                @if (!_showSummary && group.HasConflicts)
                {
                    var column = group.ConflictingColumns[_questionIndex];
                    var values = group.RowIndices.Select(index =>
                        _result.Merged.Rows[index].Columns.TryGetValue(column, out var cell) ? cell : null).ToArray();
                    var hasMissing = values.Any(string.IsNullOrWhiteSpace);
                    var hasPresent = values.Any(value => !string.IsNullOrWhiteSpace(value));
                    var fillingGap = hasMissing && hasPresent;
                    <h4>@(fillingGap ? $"We found missing {column} information" : $"Which {column} value is correct?")</h4>
                    <p class="gs-note">@(fillingGap
                        ? "One file has information that another is missing. Choose the value you want to keep. GeoShift won't fill it in without your confirmation."
                        : "The files disagree. Pick the correct value, or keep both records if you're unsure.")</p>
                    @foreach (var index in group.RowIndices)
                    {
                        var row = _result.Merged.Rows[index];
                        var value = row.Columns.TryGetValue(column, out var cell) ? cell : null;
                        <label class="d-block border rounded p-3 mb-2" style="cursor:pointer">
                            <input type="radio" name="@($"answer-{id}-{_questionIndex}")" checked="@(draft.Sources.TryGetValue(column, out var selected) && selected == index)" @onchange="() => ChooseAnswer(id, column, index)" />
                            <strong class="ms-2">@(string.IsNullOrWhiteSpace(value) ? "(No value)" : value)</strong>
                            <span class="gs-note ms-4 d-block">@row.SourceDataset · row @row.SourceRowNumber</span>
                        </label>
                    }
                    <button class="btn btn-primary mt-3" disabled="@(!draft.Sources.ContainsKey(column))" @onclick="NextQuestion">Continue →</button>
                }
                else
                {
                    <h4>@(group.HasConflicts ? "Does this look right?" : "These records match. Keep one copy?")</h4>
                    <p class="gs-note">Review every value below before confirming. Empty values stay empty if you selected them. Your uploaded files remain unchanged.</p>
                    <div class="gs-preview-table mb-3">
                        <table class="table table-hover">
                            <tbody>
                                @foreach (var column in _result.Merged.Columns)
                                {
                                    var row = _result.Merged.Rows[GetSource(id, column)];
                                    <tr><th scope="row">@column</th><td>@(row.Columns.TryGetValue(column, out var value) ? value : "")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-primary" @onclick="() => Approve(id)">Confirm &amp; next →</button>
                }
                <div class="mt-3">
                    <a href="#" @onclick="() => Skip(id)" @onclick:preventDefault="true">I'm not sure — keep both records</a>
                </div>
                @if (_questionIndex > 0 || _showSummary)
                {
                    <div class="mt-2"><a href="#" @onclick="BackOneStep" @onclick:preventDefault="true">← Change my answer</a></div>
                }
                <p class="gs-note mt-4">@_decisions.Count confirmed · @_skipped.Count kept separate · @_result.Report.OutputRows output records</p>
            }
        </section>
        @if (ReviewComplete || _result.Duplicates.Groups.Count == 0)
        {
            <section class="gs-panel">
                <div class="gs-panel-heading"><h2>Download your results</h2><span class="gs-step">STEP 05</span></div>
                <p><strong>@_result.Report.ImportedRows imported → @_result.Report.OutputRows final records.</strong> @_decisions.Count groups combined; @_skipped.Count kept separate. Verify these totals before downloading. Original uploads remain unchanged.</p>
                <button class="btn btn-primary me-2 mb-2" @onclick="DownloadCleaned">Download cleaned CSV</button>
                <button class="btn btn-outline-primary mb-2" @onclick="DownloadAudit">Download audit report</button>
            </section>
        }
    }
</div>

@code {
    private sealed class UploadedDataset
    {
        public required string Name { get; init; }
        public required IReadOnlyList<IReadOnlyDictionary<string, string?>> Rows { get; init; }
        public required IReadOnlyList<string> Columns { get; init; }
        public required string KeyColumn { get; set; }
        public Dictionary<string, string> OutputNames { get; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private readonly List<UploadedDataset> _datasets = [];
    private MigrationWorkflowResult? _result;
    private string? _error;
    private bool _busy;
    private async Task DownloadCleaned()
    {
        if (_result is null) return;
        await DownloadCsv("GeoShift_Cleaned_Data.csv",
            MigrationCsvExporter.Cleaned(_result.Merged, _result.Resolved));
    }

    private async Task DownloadAudit()
    {
        if (_result is null) return;
        await DownloadCsv("GeoShift_Migration_Audit.csv",
            MigrationCsvExporter.Audit(_result.Merged, _result.Duplicates, _result.Resolved, _skipped));
    }

    private async Task DownloadCsv(string name, string csv)
    {
        using var stream = new MemoryStream(Encoding.UTF8.GetBytes(csv));
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("geoShiftDownloadFile", name, reference);
    }

    private int CountKind(DuplicateGroupKind kind) => _result is null ? 0 :
        _result.Duplicates.Groups.Count(group => DuplicateGroupClassifier.Classify(_result.Merged, group).Kind == kind);

    private string DescribeKind(DuplicateGroup group)
    {
        if (_result is null) return "";
        var classification = DuplicateGroupClassifier.Classify(_result.Merged, group);
        return classification.Kind switch
        {
            DuplicateGroupKind.Identical => "Identical",
            DuplicateGroupKind.Complementary => "Missing information",
            _ => "Conflicting values"
        };
    }

    private bool _confirmExact;
    private int ExactPendingCount => _result is null ? 0 : _result.Duplicates.Groups.Count(g => !g.HasConflicts && !_decisions.ContainsKey(g.RowIndices[0]) && !_skipped.Contains(g.RowIndices[0]));
    private void ApproveExactMatches()
    {
        if (_result is null) return;
        foreach (var group in _result.Duplicates.Groups.Where(g => !g.HasConflicts))
        {
            var id = group.RowIndices[0];
            if (_skipped.Contains(id) || _decisions.ContainsKey(id)) continue;
            _decisions[id] = new ConflictResolutionDecision(id, new Dictionary<string, int>());
        }
        _confirmExact = false;
        RefreshResolution();
        while (_reviewIndex < _result.Duplicates.Groups.Count && _decisions.ContainsKey(_result.Duplicates.Groups[_reviewIndex].RowIndices[0])) _reviewIndex++;
    }
    private int _reviewIndex;
    private int _questionIndex;
    private bool _showSummary;
    private bool ReviewComplete => _result is not null && _reviewIndex >= _result.Duplicates.Groups.Count;
    private readonly HashSet<int> _skipped = [];

    private sealed class DraftDecision
    {
        public int KeepRow { get; set; }
        public Dictionary<string, int> Sources { get; } = new(StringComparer.OrdinalIgnoreCase);
    }
    private readonly Dictionary<int, DraftDecision> _drafts = [];
    private readonly Dictionary<int, ConflictResolutionDecision> _decisions = [];

    private int GetSource(int id, string column) =>
        _drafts[id].Sources.TryGetValue(column, out var index) ? index : _drafts[id].KeepRow;

    private void ChooseAnswer(int id, string column, int index)
    {
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (!group.RowIndices.Contains(index) || !group.ConflictingColumns.Contains(column)) return;
        _drafts[id].Sources[column] = index;
        _decisions.Remove(id);
        _skipped.Remove(id);
        _showSummary = false;
        RefreshResolution();
    }

    private void BackOneStep()
    {
        if (_showSummary) { _showSummary = false; _questionIndex = Math.Max(0, _questionIndex); }
        else if (_questionIndex > 0) _questionIndex--;
    }

    private void ReviewAgain()
    {
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
    }

    private void NextQuestion()
    {
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (_questionIndex < group.ConflictingColumns.Count - 1)
            _questionIndex++;
        else if (group.ConflictingColumns.All(column => _drafts[group.RowIndices[0]].Sources.ContainsKey(column)))
            _showSummary = true;
    }

    private void Approve(int id)
    {
        var draft = _drafts[id];
        if (_result is null) return;
        var group = _result.Duplicates.Groups[_reviewIndex];
        if (group.ConflictingColumns.Any(column => !draft.Sources.ContainsKey(column))) return;
        _decisions[id] = new ConflictResolutionDecision(draft.KeepRow,
            new Dictionary<string, int>(draft.Sources, StringComparer.OrdinalIgnoreCase));
        _skipped.Remove(id);
        RefreshResolution();
        NextGroup();
    }

    private void Undo(int id) { _decisions.Remove(id); RefreshResolution(); }
    private void Skip(int id)
    {
        _decisions.Remove(id);
        _skipped.Add(id);
        RefreshResolution();
        NextGroup();
    }
    private void PreviousGroup() { if (_reviewIndex > 0) { _reviewIndex--; _questionIndex = 0; _showSummary = false; } }
    private void NextGroup()
    {
        if (_result is not null && _reviewIndex < _result.Duplicates.Groups.Count) _reviewIndex++;
        _questionIndex = 0;
        _showSummary = false;
    }
    private void ResetDecisions()
    {
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        RefreshResolution();
    }

    private void RefreshResolution()
    {
        if (_result is null) return;
        try
        {
            var resolved = new ConflictResolutionEngine().Resolve(
                _result.Merged, _result.Duplicates, _decisions.Values.ToArray());
            var report = new MigrationReportEngine().Build(_result.Merged, _result.Duplicates, resolved);
            _result = _result with { Resolved = resolved, Report = report };
            _error = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidDataException)
        {
            _error = ex.Message;
        }
    }


    private async Task LoadFiles(InputFileChangeEventArgs args)
    {
        _busy = true;
        _error = null;
        _result = null;
        _datasets.Clear();
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        try
        {
            var files = args.GetMultipleFiles(3);
            foreach (var file in files)
            {
                if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase) &&
                    !file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
                    throw new InvalidDataException("Only CSV and XLSX files are supported.");
                await using var stream = file.OpenReadStream(2 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                IReadOnlyList<IReadOnlyDictionary<string, string?>> rows;
                if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
                    rows = MigrationXlsxReader.Read(buffer);
                else
                {
                    using var reader = new StreamReader(buffer);
                    rows = MigrationCsvReader.Read(reader);
                }
                var columns = rows.Count > 0 ? rows[0].Keys.ToArray() : Array.Empty<string>();
                if (columns.Length == 0)
                    throw new InvalidDataException($"'{file.Name}' has no data rows.");
                var uploaded = new UploadedDataset
                {
                    Name = file.Name,
                    Rows = rows,
                    Columns = columns,
                    KeyColumn = columns[0]
                };
                foreach (var column in columns) uploaded.OutputNames[column] = column;
                _datasets.Add(uploaded);
            }
            if (_datasets.Select(x => x.Name).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _datasets.Count)
                throw new InvalidDataException("Files must have distinct names.");
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException)
        {
            _datasets.Clear();
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private void SetOutputName(UploadedDataset dataset, string column, string? name)
    {
        if (!dataset.Columns.Contains(column)) return;
        dataset.OutputNames[column] = name?.Trim() ?? "";
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
    }

    private void SetKey(UploadedDataset dataset, string? column)
    {
        if (column is not null && dataset.Columns.Contains(column)) dataset.KeyColumn = column;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
    }

    private void RunPreview()
    {
        _error = null;
        _result = null;
        _drafts.Clear();
        _decisions.Clear();
        _skipped.Clear();
        _reviewIndex = 0;
        _questionIndex = 0;
        _showSummary = false;
        try
        {
            foreach (var dataset in _datasets)
            {
                var targets = dataset.Columns.Select(column =>
                    column == dataset.KeyColumn ? "GeoShift Match Key" : dataset.OutputNames[column]).ToArray();
                if (targets.Any(string.IsNullOrWhiteSpace))
                    throw new InvalidDataException($"Every output column in '{dataset.Name}' needs a name.");
                if (targets.Distinct(StringComparer.OrdinalIgnoreCase).Count() != targets.Length)
                    throw new InvalidDataException($"'{dataset.Name}' maps multiple columns to the same output name. Give each field a unique name.");
            }
            var inputs = _datasets.Select(d => new MigrationWorkflowDataset(
                d.Name, d.Rows,
                d.Columns.Select(column => new ColumnMappingRule(column,
                    column == d.KeyColumn ? "GeoShift Match Key" : d.OutputNames[column])).ToArray())).ToArray();
            _result = new MigrationWorkflowEngine().Execute(
                new MigrationWorkflowRequest(inputs, ["GeoShift Match Key"], []));
            foreach (var group in _result.Duplicates.Groups)
                _drafts.Add(group.RowIndices[0], new DraftDecision { KeepRow = group.RowIndices[0] });
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException)
        {
            _error = ex.Message;
        }
    }
}
