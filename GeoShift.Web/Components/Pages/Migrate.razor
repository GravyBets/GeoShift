    private void StartCorrection(MigrationValidationIssue issue)
    {
        _editingIssue = issue;
        var row = CorrectedRows.Rows.First(r => r.OriginalRowIndex == issue.OriginalRowIndex);
        _replacementValue = row.Columns.TryGetValue(issue.Column, out var value) ? value ?? "" : "";
    }

    private void CancelCorrection() => _editingIssue = null;

    private void ConfirmCorrection()
    {
        if (_result is null || _editingIssue is null) return;
        var issue = _editingIssue;
        var row = _result.Resolved.Rows.First(r => r.OriginalRowIndex == issue.OriginalRowIndex);
        row.Columns.TryGetValue(issue.Column, out var original);
        var key = (issue.OriginalRowIndex, issue.Column.ToUpperInvariant());
        if (string.Equals(original ?? "", _replacementValue, StringComparison.Ordinal))
            _corrections.Remove(key);
        else
            _corrections[key] = new MigrationCorrection(issue.OriginalRowIndex, issue.Column, original, _replacementValue);
        _editingIssue = null;
    }

    private readonly HashSet<string> _requiredColumns = new(StringComparer.OrdinalIgnoreCase);
    private MigrationValidationResult CurrentValidation => _result is null
