@page "/analyze"
@rendermode InteractiveServer
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Text
@using GeoShift.Core.Models
@using GeoShift.Core.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Analyze File - GeoShift</PageTitle>

<h1>GeoShift</h1>
<p>Upload a KML or KMZ file to analyze its contents.</p>

<div class="card p-4 mb-4">
    <InputFile OnChange="OnFileSelected"
               accept=".kml,.kmz" />

    <p class="mt-2">
        Selected file:
        @(_selectedFile?.Name ?? "NONE")
    </p>

    <button class="btn btn-primary mt-3"
            @onclick="AnalyzeFile"
            disabled="@(_selectedFile is null || _isAnalyzing)">
        @(_isAnalyzing ? "Processing..." : "Analyze File")
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        @_error
    </div>
}

@if (_result is not null)
{
    <h3>Analysis Results</h3>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card p-3">
                <strong>Placemarks</strong>
                <h2>@_result.PlacemarkCount</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <strong>Points</strong>
                <h2>@_result.PointCount</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <strong>Paths</strong>
                <h2>@_result.LineStringCount</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <strong>Polygons</strong>
                <h2>@_result.PolygonCount</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <strong>Folders</strong>
                <h2>@_result.FolderCount</h2>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-outline-primary me-2"
                @onclick="PreviewCsv"
                disabled="@_isAnalyzing">
            @(_isAnalyzing ? "Processing..." : "Preview CSV")
        </button>
        <button class="btn btn-success"
                @onclick="DownloadCsv"
                disabled="@_isAnalyzing">
            @(_isAnalyzing ? "Converting..." : "Download CSV")
        </button>
    </div>
}

@if (_previewRows is not null && _previewRows.Count > 0)
{
    <div class="card p-4 mt-4">
        <h3>CSV Preview</h3>
        <p class="text-muted">
            Showing up to 10 exported records. Download the CSV for the full dataset.
        </p>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm">
                <thead>
                    <tr>
                        @foreach (var header in _previewRows[0])
                        {
                            <th scope="col">@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in _previewRows.Skip(1))
                    {
                        <tr>
                            @foreach (var value in record)
                            {
                                <td style="white-space: pre-wrap;">@value</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_conversionResult is not null)
{
    <div class="card p-4 mt-4">
        <h3 class="mb-3">Conversion Summary</h3>

        <div class="alert alert-success">
            CSV conversion completed successfully.
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card p-3">
                    <strong>Points Exported</strong>
                    <h2>@_conversionResult.ExportedPointCount</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3">
                    <strong>Invalid Points Skipped</strong>
                    <h2>@_conversionResult.SkippedPointCount</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3">
                    <strong>Paths Excluded</strong>
                    <h2>@_conversionResult.ExcludedLineStringCount</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3">
                    <strong>Polygons Excluded</strong>
                    <h2>@_conversionResult.ExcludedPolygonCount</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3">
                    <strong>Custom Columns</strong>
                    <h2>@_conversionResult.CustomColumnCount</h2>
                </div>
            </div>
        </div>

        @if (_conversionResult.HasWarnings)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <strong>Some data was not exported.</strong>
                <p class="mb-0 mt-2">
                    This CSV export includes points, including those
                    nested inside MultiGeometry. Invalid point
                    coordinates are skipped, and paths and polygons
                    are excluded. Review the counts above.
                </p>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3 mb-0">
                All detected points were exported.
                No paths or polygons were detected.
            </div>
        }
    </div>
}

@code {
    private const long MaxFileSize = 50 * 1024 * 1024;

    private IBrowserFile? _selectedFile;
    private KmlAnalysisResult? _result;
    private KmlCsvConversionResult? _conversionResult;
    private IReadOnlyList<IReadOnlyList<string>>? _previewRows;

    private string? _error;
    private bool _isAnalyzing;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _result = null;
        _conversionResult = null;
        _previewRows = null;
        _previewRows = null;
        _error = null;
    }

    private async Task AnalyzeFile()
    {
        if (_selectedFile is null)
            return;

        _isAnalyzing = true;
        _error = null;
        _result = null;
        _conversionResult = null;

        try
        {
            var extension = Path.GetExtension(_selectedFile.Name)
                .ToLowerInvariant();

            if (extension is not (".kml" or ".kmz"))
            {
                _error = "Please select a KML or KMZ file.";
                return;
            }

            if (_selectedFile.Size > MaxFileSize)
            {
                _error = "File exceeds the 50 MB limit.";
                return;
            }

            await using var source =
                _selectedFile.OpenReadStream(MaxFileSize);

            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            memory.Position = 0;

            _result = extension == ".kmz"
                ? new KmzAnalyzer().Analyze(memory)
                : new KmlAnalyzer().Analyze(memory);
        }
        catch (Exception ex) when (
            ex is IOException
            or System.Xml.XmlException
            or InvalidDataException)
        {
            _error = "Unable to analyze this file. " + ex.Message;
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private async Task PreviewCsv()
    {
        if (_selectedFile is null)
            return;

        _error = null;
        _conversionResult = null;
        _previewRows = null;
        _isAnalyzing = true;

        try
        {
            var extension = Path.GetExtension(_selectedFile.Name)
                .ToLowerInvariant();

            await using var source = _selectedFile.OpenReadStream(MaxFileSize);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            memory.Position = 0;

            var conversion = extension switch
            {
                ".kmz" => new KmzAnalyzer().ConvertToCsvWithSummary(memory),
                ".kml" => new KmlCsvConverter().ConvertWithSummary(memory),
                _ => throw new InvalidDataException("Unsupported file type.")
            };

            _previewRows = CsvPreviewReader.Read(conversion.CsvContent);
            _conversionResult = conversion;
        }
        catch (Exception ex) when (
            ex is IOException or System.Xml.XmlException or InvalidDataException)
        {
            _error = "Unable to preview this file. " + ex.Message;
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private async Task DownloadCsv()
    {
        if (_selectedFile is null)
            return;

        _error = null;
        _conversionResult = null;
        _isAnalyzing = true;

        try
        {
            var extension = Path.GetExtension(
                _selectedFile.Name).ToLowerInvariant();

            await using var source =
                _selectedFile.OpenReadStream(MaxFileSize);

            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            memory.Position = 0;

            var conversion = extension switch
            {
                ".kmz" => new KmzAnalyzer()
                    .ConvertToCsvWithSummary(memory),

                ".kml" => new KmlCsvConverter()
                    .ConvertWithSummary(memory),

                _ => throw new InvalidDataException(
                    "Unsupported file type.")
            };

            var bytes = Encoding.UTF8.GetBytes(
                conversion.CsvContent);

            using var csvStream = new MemoryStream(bytes);
            using var streamReference =
                new DotNetStreamReference(csvStream);

            var fileName = Path.GetFileNameWithoutExtension(
                _selectedFile.Name) + ".csv";

            await JS.InvokeVoidAsync(
                "geoShiftDownloadFile",
                fileName,
                streamReference);

            _conversionResult = conversion;
        }
        catch (Exception ex) when (
            ex is IOException
            or System.Xml.XmlException
            or InvalidDataException)
        {
            _error = "Unable to convert this file. " + ex.Message;
        }
        finally
        {
            _isAnalyzing = false;
        }
    }
}
