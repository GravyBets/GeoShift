@page "/analyze"
@rendermode InteractiveServer
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Text
@using GeoShift.Core.Models
@using GeoShift.Core.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Convert KML &amp; KMZ — GeoShift</PageTitle>

<div class="gs-container gs-workspace">
    <div class="gs-page-kicker">THE CONVERSION WORKSPACE</div>
    <h1 class="gs-page-title">Convert geographic data.</h1>
    <p class="gs-page-description">Upload a KML or KMZ file to analyze your data, preview the output, and export clean CSV.</p>

    <section class="gs-panel">
        <div class="gs-panel-heading"><h2>Upload your file</h2><span class="gs-step">STEP 01</span></div>
        <div class="gs-dropzone" id="gs-file-dropzone" role="button" tabindex="0" aria-label="Choose or drop a KML or KMZ file">
            <div class="gs-upload-icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3m0 0L7 8m5-5 5 5"/><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg></div>
            <strong>Drag &amp; drop your KML or KMZ file here</strong>
            <p>Drop a file anywhere in this area, or select one from your computer</p>
            <span class="gs-browse-btn" aria-hidden="true">Browse files <span>↗</span></span>
            <small class="gs-upload-hint">KML or KMZ · Up to 50 MB</small>
            <InputFile @key="_fileInputKey" OnChange="OnFileSelected" accept=".kml,.kmz" disabled="@_isAnalyzing" class="gs-hidden-file-input" aria-label="Select a KML or KMZ file" />
        </div>
        @if (_selectedFile is not null)
        {
            <div class="gs-file-info"><span aria-hidden="true">📄</span><strong>@_selectedFile.Name</strong><span>· @((_selectedFile.Size / 1024.0).ToString("N1")) KB</span><button type="button" class="gs-clear-file" @onclick="ClearFile" disabled="@_isAnalyzing" aria-label="Clear selected file">✕ Remove</button></div>
        }
        <div class="gs-action-row">
            <button class="btn btn-primary" @onclick="AnalyzeFile" disabled="@(_selectedFile is null || _isAnalyzing)">
                @(_isAnalyzing ? "Processing..." : "Analyze file →")
            </button>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_result is not null)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>File analysis</h2><span class="gs-step">STEP 02</span></div>
            <div class="gs-stats">
                <div class="gs-stat"><div class="gs-stat-label">Placemarks</div><div class="gs-stat-value">@_result.PlacemarkCount</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Points</div><div class="gs-stat-value">@_result.PointCount</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Paths</div><div class="gs-stat-value">@_result.LineStringCount</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Polygons</div><div class="gs-stat-value">@_result.PolygonCount</div></div>
                <div class="gs-stat"><div class="gs-stat-label">Folders</div><div class="gs-stat-value">@_result.FolderCount</div></div>
            </div>
            <div class="gs-action-row">
                <button class="btn btn-outline-primary" @onclick="PreviewCsv" disabled="@_isAnalyzing">
                    @(_isAnalyzing ? "Processing..." : "Preview CSV")
                </button>
                <button class="btn btn-success" @onclick="DownloadCsv" disabled="@_isAnalyzing">
                    @(_isAnalyzing ? "Converting..." : "Download CSV ↓")
                </button>
            </div>
        </section>
    }

    @if (_previewRows is not null && _previewRows.Count > 0)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>CSV preview</h2><span class="gs-step">STEP 03</span></div>
            <p class="gs-note">Showing up to 10 exported records. Download the CSV for the complete dataset.</p>
            <div class="gs-preview-table">
                <table class="table table-hover">
                    <thead><tr>
                        @foreach (var header in _previewRows[0])
                        {
                            <th scope="col">@header</th>
                        }
                    </tr></thead>
                    <tbody>
                        @foreach (var record in _previewRows.Skip(1))
                        {
                            <tr>
                                @foreach (var value in record)
                                {
                                    <td style="white-space:pre-wrap">@value</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_conversionResult is not null)
    {
        <section class="gs-panel">
            <div class="gs-panel-heading"><h2>Data-quality report</h2><span class="gs-step">CONVERSION SUMMARY</span></div>
            <div class="gs-stats">
                <div class="gs-stat small-stat"><div class="gs-stat-label">Points exported</div><div class="gs-stat-value">@_conversionResult.ExportedPointCount</div></div>
                <div class="gs-stat small-stat"><div class="gs-stat-label">Invalid points skipped</div><div class="gs-stat-value">@_conversionResult.SkippedPointCount</div></div>
                <div class="gs-stat small-stat"><div class="gs-stat-label">Paths excluded</div><div class="gs-stat-value">@_conversionResult.ExcludedLineStringCount</div></div>
                <div class="gs-stat small-stat"><div class="gs-stat-label">Polygons excluded</div><div class="gs-stat-value">@_conversionResult.ExcludedPolygonCount</div></div>
                <div class="gs-stat small-stat"><div class="gs-stat-label">Custom columns</div><div class="gs-stat-value">@_conversionResult.CustomColumnCount</div></div>
            </div>
            <div class="gs-quality">
                @if (_conversionResult.HasWarnings)
                {
                    <div class="alert alert-warning mb-0">
                        <strong>Some data was not exported.</strong>
                        <p class="mb-0 mt-2">CSV includes points, including those nested in MultiGeometry. Invalid coordinates are skipped; paths and polygons are excluded. Review the counts above.</p>
                    </div>
                }
                else
                {
                    <div class="alert alert-success mb-0">All detected points were exported. No paths or polygons were detected.</div>
                }
            </div>
        </section>
    }
</div>

@code {
    private const long MaxFileSize = 50 * 1024 * 1024;

    private IBrowserFile? _selectedFile;
    private KmlAnalysisResult? _result;
    private KmlCsvConversionResult? _conversionResult;
    private IReadOnlyList<IReadOnlyList<string>>? _previewRows;

    private string? _error;
    private bool _isAnalyzing;
    private int _fileInputKey;
    private string? _preparedCsvPath;
    private string? _preparedFileName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("geoShiftSetupDropzone", "gs-file-dropzone");
    }

    private void ClearFile()
    {
        if (_isAnalyzing)
            return;

        _selectedFile = null;
        _result = null;
        _conversionResult = null;
        _previewRows = null;
        _error = null;
        _fileInputKey++;
        DeletePreparedCsv();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _result = null;
        _conversionResult = null;
        _previewRows = null;
        _error = null;
        DeletePreparedCsv();
    }

    private async Task AnalyzeFile()
    {
        if (_selectedFile is null)
            return;

        _isAnalyzing = true;
        _error = null;
        _result = null;
        _conversionResult = null;
        _previewRows = null;
        DeletePreparedCsv();

        try
        {
            var extension = Path.GetExtension(_selectedFile.Name)
                .ToLowerInvariant();

            if (extension is not (".kml" or ".kmz"))
            {
                _error = "Please select a KML or KMZ file.";
                return;
            }

            if (_selectedFile.Size > MaxFileSize)
            {
                _error = "File exceeds the 50 MB limit.";
                return;
            }

            await using var source =
                _selectedFile.OpenReadStream(MaxFileSize);

            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            memory.Position = 0;

            _result = extension == ".kmz"
                ? new KmzAnalyzer().Analyze(memory)
                : new KmlAnalyzer().Analyze(memory);
        }
        catch (Exception ex) when (
            ex is IOException
            or System.Xml.XmlException
            or InvalidDataException)
        {
            _error = "Unable to analyze this file. " + ex.Message;
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private async Task PreviewCsv()
    {
        if (_selectedFile is null) return;
        _error = null;
        _isAnalyzing = true;
        try
        {
            await EnsurePreparedCsv();
            using var reader = new StreamReader(_preparedCsvPath!);
            _previewRows = GeoShiftCsvPreview.ReadFirstRows(reader, 10);
        }
        catch (Exception ex) when (ex is IOException or System.Xml.XmlException
            or InvalidDataException or InvalidOperationException)
        {
            _error = "Unable to preview this file. " + ex.Message;
        }
        finally { _isAnalyzing = false; }
    }

    private async Task DownloadCsv()
    {
        if (_selectedFile is null) return;
        _error = null;
        _isAnalyzing = true;
        try
        {
            await EnsurePreparedCsv();
            await using var csv = File.OpenRead(_preparedCsvPath!);
            using var reference = new DotNetStreamReference(csv);
            await JS.InvokeVoidAsync("geoShiftDownloadFile", _preparedFileName, reference);
        }
        catch (Exception ex) when (ex is IOException or System.Xml.XmlException
            or InvalidDataException or InvalidOperationException)
        {
            _error = "Unable to download CSV. " + ex.Message;
        }
        finally { _isAnalyzing = false; }
    }

    private async Task EnsurePreparedCsv()
    {
        if (_preparedCsvPath is not null && File.Exists(_preparedCsvPath))
            return;

        if (_selectedFile is null)
            throw new InvalidOperationException("Select a file first.");

        var extension = Path.GetExtension(_selectedFile.Name).ToLowerInvariant();
        if (extension is not (".kml" or ".kmz") || _selectedFile.Size > MaxFileSize)
            throw new InvalidDataException("Select a KML or KMZ file up to 50 MB.");

        var inputPath = Path.GetTempFileName();
        var outputPath = Path.GetTempFileName();
        try
        {
            await using (var source = _selectedFile.OpenReadStream(MaxFileSize))
            await using (var destination = File.Create(inputPath))
                await source.CopyToAsync(destination);

            await using var input = File.OpenRead(inputPath);
            using (var writer = new StreamWriter(outputPath, false, new UTF8Encoding(true)))
            {
                _conversionResult = extension == ".kmz"
                    ? new KmzAnalyzer().ConvertToCsvStreaming(input, writer)
                    : new StreamingKmlCsvConverter().Convert(input, writer);
            }

            _preparedCsvPath = outputPath;
            _preparedFileName = Path.GetFileNameWithoutExtension(_selectedFile.Name) + ".csv";
        }
        finally
        {
            File.Delete(inputPath);
            if (_preparedCsvPath != outputPath)
                File.Delete(outputPath);
        }
    }

    private void DeletePreparedCsv()
    {
        if (_preparedCsvPath is not null)
        {
            try { File.Delete(_preparedCsvPath); }
            catch (IOException) { /* Temporary file can be cleaned up later. */ }
        }
        _preparedCsvPath = null;
        _preparedFileName = null;
    }
}
